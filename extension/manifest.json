{
  "manifest_version": 3,
  "name": "RoleFindr Apply Helper",
  "version": "0.0.1",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:8000/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:3000/*"
    ]
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}